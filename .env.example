# Copy to .env to change settings. Every value has a sensible default in app/config.py,
# so the app also runs without a .env file.

# ---------- Language model (Ollama, on this computer) ----------
# ollama     = answers written by a local model (install Ollama, then: ollama pull qwen3:14b)
# extractive = no model; answers quote the most relevant sentences
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:14b
OLLAMA_URL=http://localhost:11434
# How much text the model reads at once (tokens). 8192 fits qwen3:14b on a 16 GB GPU.
OLLAMA_CONTEXT=8192
OLLAMA_MAX_TOKENS=1024
OLLAMA_KEEP_ALIVE=30m

# ---------- Local search models (downloaded once: python scripts/download_models.py) ----------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------- Documents ----------
# false = documents are wiped when the app closes or restarts (default; nothing is left on disk)
KEEP_DOCUMENTS=false
# true = after a document is ready, the model reads it in full in the background, so summaries,
# key points and brainstorming cover the whole document. Uses the GPU for a short while per document.
PREPARE_OVERVIEWS=true
MAX_UPLOAD_MB=50

# ---------- Answer quality ----------
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=6
# Minimum evidence relevance (0-1) before the model is asked at all. Tune it with the benchmark.
ABSTAIN_THRESHOLD=0.30

# ---------- Interface ----------
API_URL=http://localhost:8000
